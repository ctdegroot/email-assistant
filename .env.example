# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_MOTION_CHANNEL=email-to-motion
SLACK_CALENDAR_CHANNEL=email-to-calendar

# Slack Socket Mode — required for /availability slash command
# Generate at api.slack.com/apps → your app → Basic Information → App-Level Tokens
SLACK_APP_TOKEN=xapp-...

# Motion
MOTION_API_KEY=...
MOTION_WORKSPACE_ID=...
# Your Motion user ID — find it at usemotion.com → Settings → Profile → Copy member ID
MOTION_ASSIGNEE_ID=...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# SMTP (Gmail)
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password

# Calendar destination
CALENDAR_EMAIL=you@domain.com

# Outlook ICS feed — required for /availability
# In Outlook Web: Settings → Calendar → Shared calendars → Publish a calendar → copy ICS link
OUTLOOK_ICS_URL=https://outlook.office365.com/owa/calendar/...

# Your Outlook/university email — used to exclude yourself from attendee lists in conflict emails.
# Usually your university address, which differs from SMTP_USER (Gmail). Falls back to SMTP_USER if not set.
CALENDAR_OWNER_EMAIL=you@university.edu

# Access control — only this Slack user ID can use slash commands and shortcuts.
# Find yours: open Slack → click your name → Profile → ··· (three dots) → Copy member ID
ALLOWED_SLACK_USER_ID=U012AB3CD

# Channel to post weekday morning conflict alerts to (defaults to SLACK_MOTION_CHANNEL).
# SLACK_CONFLICT_CHANNEL=email-conflicts

# Notes inbox — Slack channel name (without #) for email-to-Obsidian-note forwarding.
# Leave unset to disable note processing entirely.
# SLACK_NOTES_CHANNEL=notes-inbox

# Where to write generated .md note files (always written here for local backup/inspection).
# Defaults to ~/email_to_motion_notes/ — change to an absolute path on a Linux server.
# NOTES_OUTPUT_PATH=~/email_to_motion_notes

# ── Obsidian vault delivery ─────────────────────────────────────────────────────
# Set OBSIDIAN_DELIVERY=git to push notes to your Obsidian vault via Git.
# Leave unset (or "local") to write only to NOTES_OUTPUT_PATH.
# OBSIDIAN_DELIVERY=git

# Absolute (or ~/…) path to the local Git clone of your Obsidian vault on this server.
# OBSIDIAN_VAULT_PATH=~/obsidian-vault

# Subfolder inside the vault where inbox notes will be written.
# The folder is created automatically if it doesn't exist.
# OBSIDIAN_NOTES_SUBFOLDER=Notes/Inbox

# ── Watch-date reminders ────────────────────────────────────────────────────────
# Slack channel name (without #) for automated deadline reminders.
# The daily 9am scan posts here when a watched date is approaching.
# Leave unset to disable reminders.
# SLACK_REMINDERS_CHANNEL=auto-reminders

# ── Signer identity ─────────────────────────────────────────────────────────────
# Used by the PDF signer (auto-fill name/title/institution fields) and the
# reference letter generator (personalises the Claude prompt).
SIGNER_NAME=Dr. Jane Smith
SIGNER_TITLE=Associate Professor
SIGNER_DEPARTMENT=Department of Mechanical and Materials Engineering
SIGNER_INSTITUTION=Western University
# SIGNER_EMAIL=jsmith@university.edu    # optional, fills email fields if present

# ── PDF sign-and-date channel ────────────────────────────────────────────────────
# Slack channel name (without #) for the PDF signing pipeline.
# Upload a fillable PDF here; the bot signs it, fills today's date, and
# auto-populates name/title/institution fields it can identify.
# Leave unset to disable.
# SLACK_SIGN_CHANNEL=sign-pdf

# ── Reference letter generator ──────────────────────────────────────────────────
# Slack channel name (without #) for YAML-driven reference letter generation.
# Upload a filled-in YAML context file (+ optional CV) to trigger generation.
# Leave unset to disable.
# SLACK_REFLETTER_CHANNEL=ref-letters

# Directory containing LaTeX template support files:
#   WesternLetter.cls, Signature.pdf, Engineer_Stacked_PurpleGrey.png
# Defaults to ref_letter_templates/ inside the project directory.
# REF_LETTER_TEMPLATES_DIR=/absolute/path/to/ref_letter_templates

# Where to write generated .tex, .pdf, and .zip files.
# Defaults to ~/email_to_motion_ref_letters/
# REF_LETTERS_OUTPUT_PATH=~/email_to_motion_ref_letters

# ── Activity log ────────────────────────────────────────────────────────────────
# JSONL file that records every item processed (tasks, notes, events, ref letters,
# and watch-date reminder interactions).  Each line is a JSON object with a UTC
# timestamp, event type, outcome, and type-specific metadata.
# Defaults to ~/.email_to_motion/activity.jsonl
# ACTIVITY_LOG_PATH=~/.email_to_motion/activity.jsonl
